# Placeholders only. Never commit real credentials. Put comments on their own lines.

# --- Providers ---
# Bifrost gateway (OpenAI-compatible). Must end in /v1. Open-source Bifrost listens on 8080 by default.
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=replace-with-bifrost-virtual-key
# Model ids are usually provider/model
BIFROST_MODEL=openai/gpt-4o-mini
TAVILY_API_KEY=tvly-replace-me

# --- Optional model routing ---
# BIFROST_FAST_MODEL=openai/gpt-4o-mini
# BIFROST_FALLBACK_MODEL=anthropic/claude-3-5-haiku
# PRICE_INPUT_PER_MTOK=0.15
# PRICE_OUTPUT_PER_MTOK=0.60

# --- Environment ---
# development | production
APP_ENV=development
TRUST_PROXY=0
DB_PATH=data/freshcode.db

# --- Accounts and sessions ---
ALLOW_REGISTRATION=1
SESSION_TTL_HOURS=12
SESSION_MAX_DAYS=7
# Defaults to on when APP_ENV=production (requires HTTPS)
# COOKIE_SECURE=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Limits ---
RATE_LIMIT_PER_MINUTE=120
HEAVY_RATE_LIMIT_PER_MINUTE=20
DAILY_RUN_QUOTA=200
AGENT_TIMEOUT_SECONDS=180
MAX_OUTPUT_TOKENS=1800
CONTEXT_BUDGET_TOKENS=900
CACHE_TTL_SECONDS=900
UPSTREAM_RETRIES=2
REQUEST_TIMEOUT_SECONDS=25

# --- Code execution ---
# off | local | docker. Empty = local in development, off in production.
# local is NOT a sandbox. docker needs a Docker host and the runner image (make runner-image).
# RUNNER_MODE=docker
RUNNER_IMAGE=freshcode-runner:latest
RUNNER_TIMEOUT_SECONDS=8
